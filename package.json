{
  "name": "frida-shieldbreaker-agents",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "GumJS instrumentation agents for Frida-ShieldBreaker, bundled with frida-compile into the single payload core/loader.py injects.",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/ensure-dist-dir.js",
    "build": "frida-compile agents/loader.js -o agents/dist/agent.js -c",
    "prebuild:debug": "node scripts/ensure-dist-dir.js",
    "build:debug": "frida-compile agents/loader.js -o agents/dist/agent.js -S",
    "prewatch": "node scripts/ensure-dist-dir.js",
    "watch": "frida-compile agents/loader.js -o agents/dist/agent.js -w -S",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.10.0",
    "@types/node": "^22.15.0",
    "frida-compile": "^19.0.5",
    "typescript": "^5.8.3"
  }
}
